# config.example.env —— 所有脚本路径均可经环境变量覆盖。
# 复制本文件为 .env 并按需修改，运行前 `set VAR=值`（Windows cmd）或
# `export VAR=值`（bash）后再启动脚本即可，无需改代码。
#
# 下方为【本机当前】默认值，换机器时改这里。

# ---- 文献项目根目录（存放 literature/ 与 logs/）----
LIT_ROOT=D:\Compatible_solute_project
# 下载落盘目录（downloads 写到这里）
LIT_OUT=D:\Compatible_solute_project\literature\authorized_pdf_v2
# literature 目录（断点续跑时扫描已存在 PDF）
LIT_DIR=D:\Compatible_solute_project\literature
# 下载日志 CSV
LIT_LOG=D:\Compatible_solute_project\logs\authorized_browser_download_v2.csv
# 运行状态 JSON
LIT_STATE=D:\Compatible_solute_project\logs\v4_runner_state.json

# ---- 核验清单 xlsx（split_three_v3.py 的输入）----
HEN_XLSX=D:\xwechat_files\wxid_oybpumgljy8b11_7a1e\msg\file\2026-09\non_oa_literature_links_核验(1).xlsx
# 汇总/拆分产物输出目录
OUTDIR=C:\Users\17965\WorkBuddy\2026-09-16-19-38-28\output

# ---- Chrome（必须是已登录机构订阅的真实 Chrome）----
CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PROFILE=D:\Compatible_solute_project\browser_profile_authorized
# CDP 调试端口
CDP_PORT=9222
CDP_HTTP=http://127.0.0.1:9222

# ---- 下载器读取的待下队列（make_queue.py 的输出，DOI,Title,Publisher）----
QUEUE_PATH=C:\Users\17965\WorkBuddy\2026-09-16-19-38-28\remaining.csv

# ---- 工作区（supervisor.py 找 downloader_v4.py 的位置）----
WORKSPACE=C:\Users\17965\WorkBuddy\2026-09-16-19-38-28
# Python 解释器（supervisor 用它拉起 downloader）
PY_BIN=D:\anaconda\python.exe
